FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    gcc \
    g++ \
    make \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY Infrastructure/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY Core\ System/ ./Core\ System/
COPY Cryptographic\ Modules/ ./Cryptographic\ Modules/
COPY DeFi\ Agents/ ./DeFi\ Agents/
COPY Aztec\ Noir\ Integration/ ./Aztec\ Noir\ Integration/

# Create logs directory
RUN mkdir -p logs data

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

# Run distributed node
CMD ["python", "Core System/distributed_node.py"]

# Run node
CMD ["python", "distributed_node.py"]