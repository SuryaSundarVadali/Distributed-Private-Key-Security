# ──────────────────────────────────────────────
# Ethereum / ERC-8004 Integration Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.

# RPC endpoint (default: local Anvil)
ETH_RPC_URL=http://127.0.0.1:8545

# Chain ID (31337 = Anvil/Hardhat local, 1 = mainnet, 11155111 = Sepolia)
ETH_CHAIN_ID=31337

# Secure Key Vault Settings (replaces plaintext private keys)
# To create a vault run: python -c "from eth_integration.secure_key_vault import SecureKeyVault; SecureKeyVault.create_encrypted_file('vault_keys/deployer.enc', 'your-password').store_key('deployer', 'ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80')"
VAULT_PATH=vault_keys/deployer.enc
DEPLOYER_KEY_NAME=deployer
# VAULT_PASSWORD=your-password  # (optional) if set, bypasses interactive prompts

# Contract addresses (fill in after deployment)
IDENTITY_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
VALIDATION_REGISTRY_ADDRESS=
SWARM_CONTROLLER_ADDRESS=

# Default validator address for validation requests
DEFAULT_VALIDATOR_ADDRESS=

# Gas settings (optional)
GAS_LIMIT=3000000
# MAX_FEE_PER_GAS=
